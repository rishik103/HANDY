<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo Colors (link names match URDF: Link1, Link2, etc.) -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.79 0.82 0.93 1</ambient>
        <diffuse>0.79 0.82 0.93 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="Link1">
    <visual>
      <material>
        <ambient>0.79 0.82 0.93 1</ambient>
        <diffuse>0.79 0.82 0.93 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="Link2">
    <visual>
      <material>
        <ambient>0.79 0.82 0.93 1</ambient>
        <diffuse>0.79 0.82 0.93 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="Link3">
    <visual>
      <material>
        <ambient>0.79 0.82 0.93 1</ambient>
        <diffuse>0.79 0.82 0.93 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="Link4">
    <visual>
      <material>
        <ambient>0.79 0.82 0.93 1</ambient>
        <diffuse>0.79 0.82 0.93 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="Link5">
    <visual>
      <material>
        <ambient>0.79 0.82 0.93 1</ambient>
        <diffuse>0.79 0.82 0.93 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="Link6">
    <visual>
      <material>
        <ambient>0.79 0.82 0.93 1</ambient>
        <diffuse>0.79 0.82 0.93 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <!-- Gazebo ros2_control plugin for Harmonic -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find handy_config)/config/ros2_controllers.yaml</parameters>
      <ros>
        <remapping>/controller_manager:=/controller_manager</remapping>
      </ros>
    </plugin>
  </gazebo>

</robot>
